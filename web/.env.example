# Which gatekeeper the UI talks to:
#   self       → variant A (Bun + Hono + Redis), via the /api proxy
#   cloudflare → variant B (Cloudflare Waiting Room), JSON polling at the edge
VITE_WR_MODE=self

# Variant B only: where to send the visitor once Cloudflare admits them.
# Leave empty in a demo without Cloudflare in front (a synthetic payload is shown).
# VITE_WR_REAL_URL=https://shop.exemple.com/drop

# Turnstile sitekey (self mode anti-bot). Unset ⇒ no challenge before enqueue.
# Dev/test keys: pass "1x00000000000000000000AA", block "2x00000000000000000000AB".
# Must be paired with WR_TURNSTILE_SECRET on the gate.
VITE_WR_TURNSTILE_SITEKEY=1x00000000000000000000AA
