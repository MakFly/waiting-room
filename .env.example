# Waiting Room — reuses the shared `infra-redis` instance (no new Docker).
# Bun runs on the host, so we reach the published port on localhost.
REDIS_URL=redis://localhost:6379

# Signing secret for tickets and passes (HS256). Generate: openssl rand -hex 32
WR_JWT_SECRET=dev-insecure-change-me-0000000000000000000000000000000000000000

WR_GATE_PORT=8787

# Default per-drop knobs (overridable at runtime via the admin config hash).
WR_DEFAULT_CAPACITY=500        # C — max active users on the real site
WR_DEFAULT_RATE_PER_MIN=200    # admission throughput
WR_SESSION_TTL_SEC=900         # pass validity (15 min)
WR_QUEUE_METHOD=fifo           # fifo | lottery

# Admin routes bearer token (ops).
WR_ADMIN_TOKEN=dev-admin-token

# Per-IP rate limit on /enqueue (anti-bot): burst size + full-refill window (ms).
WR_ENQUEUE_RL_CAPACITY=10
WR_ENQUEUE_RL_REFILL_MS=60000

# Lottery: arrivals within the same window (ms) are shuffled together.
WR_LOTTERY_WINDOW_MS=2000
